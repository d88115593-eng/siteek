{
  "name": "prime-carpet-home-care",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Orlando cleaning and home services website with an editable admin dashboard",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/index.js",
    "check": "node --check server/index.js && node --check server/db.js && vite build",
    "smoke": "node scripts/smoke-test.mjs",
    "admin:setup": "node scripts/setup-owner.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.5.0",
    "nodemailer": "^6.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^6.3.4"
  }
}
