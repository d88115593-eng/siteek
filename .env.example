# Required in production; set your own unique values.
PORT=3001
NODE_ENV=development
SITE_URL=https://your-domain.com
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password-at-least-12-characters
# Keep these unset if you don't have an SMTP provider. The site still saves leads.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=
FROM_EMAIL=
# Optional custom data directory (needs persistent storage).
DATA_DIR=./data
